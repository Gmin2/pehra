{
  "expo": {
    "name": "pehra",
    "slug": "pehra",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "pehra",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "trade.pehra.app",
      "supportsTablet": false
    },
    "android": {
      "package": "trade.pehra.app",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-foreground.png",
        "backgroundColor": "#9E4DFD"
      },
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "pehra-passkeys.vercel.app",
              "pathPrefix": "/r/"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-build-properties",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#9E4DFD",
          "image": "./assets/splash-mark.png",
          "imageWidth": 140
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#9E4DFD",
          "icon": "./assets/notification.png"
        }
      ]
    ],
    "icon": "./assets/icon.png"
  }
}
